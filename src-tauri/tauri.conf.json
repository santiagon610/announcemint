{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Announcemint",
  "version": "1.2.0",
  "identifier": "com.santiagon610.announcemint",
  "build": {
    "beforeDevCommand": "npm run sync-version && npm run sync-brand && node scripts/start-dev-and-wait.js",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Announcemint",
        "width": 900,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "both"
      }
    },
    "android": {
      "minSdkVersion": 24,
      "autoIncrementVersionCode": false
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "hardenedRuntime": true
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "longDescription": "Convert text to speech using AWS Polly. Supports presets for two-way radio prompts and more.",
    "shortDescription": "AWS Polly text-to-speech with presets",
    "category": "Utility"
  }
}
